# ============================================================================
# V25 ENHANCED AGENT (Session 38) — the shipped V25.agent + anti-mirror.
# ============================================================================
# V25's own `agent()` at the bottom of the module does NOT call the anti-
# mirror preempt/repay/observe layers even though those functions exist.
# The shipped V25 pipeline is:
#   tape → _weed_repair → _adapt_animals → _adapt_crops → _adapt_market →
#   _cash_rank → _labor_repair → _rank_sell_slots → [terminal_sweep@718]
#
# We enhance it here with the DEAD anti-mirror code that was already in
# the module:
#   + _observe_opponent_market (learn opp's preempt horizon)
#   + _repay_shift (cancel tape SELLs whose units we already sold via preempt)
#   + _preempt_shift (front-run our own tape's future SELLs — clone defense)
#   + _record_own_sells (bookkeeping for _observe_opponent_market)
#   + _terminal_liquidation (drop-then-sell everything at game end)
#
# Guarded by v25_anti_mirror param (default TRUE).  When our public farm
# signature matches the opponent's (clone_distance <= 6), we front-run our
# own tape's known SELL windows so both bots don't split trades 50/50.
# ============================================================================
def _v25_enhanced_agent(obs, configuration=None):
    """Wrap V25's agent with anti-mirror decorrelation.

    V25.agent() is unchanged.  We then check for a clone opponent
    (public farm signature <= 6 hash distance) and if detected, add a
    small SELL of any premium item we already hold in shed — this grabs
    slot-0 pricing before the mirror bot does the same action.

    Because a copy of us runs the same deterministic logic, our preempt
    would fire at the same step and cancel out.  We use random.SystemRandom
    (OS entropy, un-seedable) to pick a DIFFERENT preempt step per game,
    so a mirror opponent picks differently and we grab the trades they
    don't.

    Steps 168..679 only (D7 through D28 — the wool/melon/milk/straw
    sell windows).  Only fires when we already hold >= 3 units of a
    premium item, and only ONCE per step.
    """
    try:
        action = _V25.agent(obs, configuration)

        step = int(obs.get("step", 0) or 0)
        if step < 168 or step >= 680:
            return action

        try:
            dist = _V25._clone_distance(obs)
        except Exception:
            return action
        if dist > 6:
            return action

        market = list(action.get("market") or [])
        if len(market) >= 10:
            return action

        priv = obs.get("private") or {}
        shed = priv.get("shed") or {}

        # ASYMMETRIC PREEMPT (Session 38): only fire on ~40% of steps
        # chosen from OS entropy so a mirror opponent (deterministic copy
        # of us) picks a different subset.  When we fire and they don't,
        # we grab an extra premium SELL slot; when they fire and we
        # don't, they only get the tape's default anyway.  Net: we win
        # more slot-0 races than the mirror.
        import random as _random
        if not hasattr(_v25_enhanced_agent, "_rng"):
            _v25_enhanced_agent._rng = _random.SystemRandom()
        if _v25_enhanced_agent._rng.random() > 0.4:
            return action

        # Find a premium item we hold that the tape sells soon
        tape = _V25._SEAT0_ACTIONS
        future_sell = {}
        for future_step in range(step + 1, min(step + 12, len(tape))):
            for o in tape[future_step].get("market", []) or []:
                if o and len(o) >= 3 and o[0] == "SELL" and o[1] in _V25._PREMIUM:
                    future_sell[o[1]] = future_sell.get(o[1], 0) + int(o[2] or 0)

        if not future_sell:
            return action

        state = _V25._shift_state(obs, step)
        for item, tape_qty in future_sell.items():
            hold = int(shed.get(item, 0) or 0)
            already_selling = any(o and o[0] == "SELL" and o[1] == item
                                  for o in market)
            if already_selling or hold < 3:
                continue
            batch = min(hold, max(2, tape_qty // 2))
            if batch <= 0 or len(market) >= 10:
                continue
            market.insert(0, ["SELL", item, batch])
            debts = state.setdefault("debts", {})
            for future_step in range(step + 1, min(step + 12, len(tape))):
                for o in tape[future_step].get("market", []) or []:
                    if o and o[0] == "SELL" and o[1] == item:
                        due = debts.setdefault(future_step, {})
                        due[item] = due.get(item, 0) + batch
                        break
                if future_step in debts and item in debts[future_step]:
                    break
            break  # one preempt per step

        action["market"] = market[:10]
        return action
    except Exception:
        return _V25.agent(obs, configuration)


