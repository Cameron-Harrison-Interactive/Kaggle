        env = make('kagriculture'); \
        env.run(['Kragriculture/Agent/main.py', 'starter']); \
        print([s.reward for s in env.steps[-1]])"
"""

# =============================================================================
# Tunable DNA. Read from Agent/dna.json if it exists, otherwise use defaults.
# auto_evolve.py mutates this file to find better parameter sets.
# =============================================================================
DEFAULT_DNA = {
    # Plant allocation
    "target_wheat":   12,
    "target_carrot":  6,
    "max_total":      18,
    # Pricing gates (per the real MARKET_PARAMS)
    "wheat_ceiling":  45,
    "wheat_floor":    20,
    "carrot_ceiling": 42,
    "carrot_floor":   10,
    # Behavior
    "dump_turn":      700,
    "buy_land":       0,
    "use_brain":      1,
}


def _load_dna():
    """Load DNA from Agent/dna.json, falling back to defaults.

    IMPORTANT: the kaggle_environments loader runs this file via
    `exec(code, env)`, which means `__file__` is NOT defined in our
    globals. We must guard every reference to it.
    """
    import json
    import os
    candidates = []
    try:
        here = os.path.dirname(__file__)
