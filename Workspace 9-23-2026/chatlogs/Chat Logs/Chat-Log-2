        elif shed.get("COW", 0) > 0 or inv.get("COW", 0) > 0:
            candidates.append((3, 4))
    candidates += [(h[0], h[1]) for h in info["harvestable"]]
    candidates += [(u[0], u[1]) for u in info["unwatered"]]
    if not is_dump and choose_crop(info["active"], targets, seeds, prices):
        # Prefer empty tiles close to the shed first, then all other empties.
        empties = sorted(info["empty"], key=lambda p: (manhattan(p, (4, 4)), p[1], p[0]))
        candidates += empties[:12]
    candidates += info["weeds"][:8]

    if candidates:
        target = min(candidates, key=lambda p: manhattan((x, y), p))
        return step_toward((x, y), target)
    return ["PASS"]


def need_feed(info):
    for _, _, _, t in info.get("animals", []):
        if not t.get("fed_today", False):
