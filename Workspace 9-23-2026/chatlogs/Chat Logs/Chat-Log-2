    from kaggle_environments import make

    challenger_path = os.path.join(AGENT_DIR, "dna.json")
    champion_path   = os.path.join(AGENT_DIR, "champion_dna.json")
    winning_path    = os.path.join(DATA_DIR, "Winning_DNA.json")

    if not os.path.exists(champion_path):
        save_dna(champion_path, load_dna(challenger_path))

    champion = load_dna(champion_path)
    best_score = float("-inf")
    best_dna = dict(champion)

    print("\n[baseline] testing current champion vs starter ...")
    save_dna(challenger_path, champion)
    env = make("kaggriculture", configuration={"episodeSteps": 720})
    p0, p1, _ = run_match(env, os.path.join(AGENT_DIR, "main.py"), "starter")
    base_fit = fitness(p0, p1)
    print(f"[baseline] champion cash=${p0:.0f}  starter=${p1:.0f}  fit={base_fit:.0f}")
    best_score = base_fit

    match_number = 1
    t0 = time.time()
    consecutive_failures = 0

    while True:
        child = mutate(champion)
        save_dna(challenger_path, child)

        if match_number % 2 == 0:
            opponent = os.path.join(AGENT_DIR, "main.py")
            opp_label = "champion"
        else:
            opponent = "starter"
            opp_label = "starter"

        try:
            env = make("kaggriculture", configuration={"episodeSteps": 720})
            my_cash, opp_cash, env = run_match(env, os.path.join(AGENT_DIR, "main.py"), opponent)
        except Exception as e:
            consecutive_failures += 1
            print(f"[{match_number}] ERROR: {e}")
            traceback.print_exc()
            if consecutive_failures > 10:
                print("Too many consecutive failures, bailing.")
                return
            continue
        consecutive_failures = 0

        fit = fitness(my_cash, opp_cash)
        won = "WIN " if my_cash > opp_cash else ("TIE " if my_cash == opp_cash else "LOSS")
        print(
            f"[{match_number:5d}] vs {opp_label:8s} | "
            f"cash=${my_cash:6.0f} (opp ${opp_cash:6.0f}) {won} | "
            f"fit={fit:6.0f} | wheat={child['target_wheat']:2d} ceil={child['wheat_ceiling']:2d}"
