                DEFAULT_DNA.update(overrides)
                return DEFAULT_DNA
        except Exception:
            pass
    return DEFAULT_DNA


# Module-level globals — load once at import time (sandbox-safe).
DNA = _load_dna()
_BRAIN = None
_BRAIN_LOADED = False
_BRAIN_OK = False


def _load_brain():
    """Load HI_Market_Brain.pkl. Returns (brain, ok) where ok=False on any
    failure. Cached after first call so we never hit the filesystem on
    later turns (timeout safety)."""
    global _BRAIN, _BRAIN_LOADED, _BRAIN_OK
    if _BRAIN_LOADED:
