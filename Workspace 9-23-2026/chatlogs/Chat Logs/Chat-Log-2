        return json.load(f)


def save_dna(path, dna):
    with open(path, "w") as f:
        json.dump(dna, f, indent=2)


def mutate(parent):
    child = {}
    for k, (lo, hi, step) in DNA_RANGES.items():
        base = parent.get(k, (lo + hi) // 2)
        jump = random.choice([-2, -1, 0, 0, 1, 2]) * step
        child[k] = max(lo, min(hi, int(base + jump)))
    return child


