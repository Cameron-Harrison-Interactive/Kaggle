"""
train_brain.py — build HI_Market_Brain.pkl from your match data.

You said you built your 1KB .pkl on your desktop using episodes.csv and
replays.parquet. This script does the same thing programmatically, so you
can rebuild it any time you download fresh matches.

Two modes:

  A) REAL DATA MODE (default if episodes.csv or replays.parquet exist):
     Reads the per-step data, builds (day, hour, current_price, inventory_qty)
     features, labels each step as 1 (sell) or 0 (hold) based on whether
     selling at that price turned out to be more profitable than holding
     for one more day, and fits a small DecisionTreeClassifier.

  B) SYNTHETIC MODE (if neither file exists):
     Runs a few self-play matches with the current main.py, scores each
     "sell" decision retrospectively against the eventual final price,
     and fits the same kind of model. This is a fallback so the brain
     file always exists and main.py can load it.

The model is intentionally tiny (~1KB on disk) because the Kaggle eval
sandbox imports it on every turn, and a giant pickle would add timeout
risk. max_depth=5 is plenty for the 4-feature problem.

Run:
    python Scripts\\train_brain.py
"""

import json
import os
import pickle
import sys
import warnings

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
AGENT_DIR = os.path.join(ROOT, "Agent")
DATA_DIR  = os.path.join(ROOT, "Data")
BRAIN_PATH = os.path.join(AGENT_DIR, "HI_Market_Brain.pkl")

# Suppress sklearn convergence warnings for cleanliness.
warnings.filterwarnings("ignore")


def train_from_real_data():
    """Try to read episodes.csv / replays.parquet and build features."""
    import numpy as np
    import pandas as pd

    episodes_csv = os.path.join(DATA_DIR, "episodes.csv")
    replays_parq = os.path.join(DATA_DIR, "replays.parquet")
    if not (os.path.exists(episodes_csv) or os.path.exists(replays_parq)):
        return None

    # The exact schema of these files depends on how Kaggle's `kaggle
    # competitions episodes <id> -v` exports them. The most common shape is
    # one row per (episode_id, step, player, key, value) which we pivot
    # to (step, day, hour, item, price, action, qty).
    # If your file has a different shape, edit this function — the rest of
    # the pipeline doesn't care.
    try:
        if os.path.exists(replays_parq):
            df = pd.read_parquet(replays_parq)
        else:
            df = pd.read_csv(episodes_csv)
    except Exception as e:
        print(f"  ! could not read data file: {e}")
        return None

    # If the file is a flat step-state log, look for the canonical columns.
    # If not, bail.
    required = {"step", "player", "item", "price", "action"}
    if not required.issubset(df.columns):
        print(f"  ! data file missing required columns {required}; have {list(df.columns)}")
        print(f"  ! falling back to synthetic data")
        return None

    # Day/hour from step.
    df["day"] = df["step"] // 24
    df["hour"] = df["step"] % 24

    # Filter to actual sell decisions on crops we care about.
    sells = df[df["action"].str.upper() == "SELL"].copy()
    if len(sells) < 10:
        print(f"  ! only {len(sells)} sell events; too few to train on. Falling back.")
        return None

    # For each sell, label = 1 if selling at that price was better than the
    # median price in the next 24 hours (proxy for "sold at a good time").
    # In practice, this is a noisy proxy; for a serious model you'd compute
    # counterfactual cash outcomes.
    X_rows = []
    y_rows = []
    for item in ("WHEAT", "CARROT"):
        sub = sells[sells["item"] == item].sort_values("step")
        if len(sub) < 3:
            continue
        for idx, row in sub.iterrows():
            step = row["step"]
            # Look ahead 24 hours for a price peak.
            future = df[(df["item"] == item) & (df["step"] > step) & (df["step"] <= step + 24)]
            if len(future) == 0:
                continue
            peak = future["price"].max()
            X_rows.append([row["day"], row["hour"], row["price"], row.get("qty", 0) or 0])
            # Label: 1 if this sell was within 80% of the next-day peak.
            y_rows.append(1 if row["price"] >= 0.8 * peak else 0)

    if len(X_rows) < 5:
        print(f"  ! only {len(X_rows)} training rows; falling back.")
        return None

    X = np.array(X_rows, dtype=np.float32)
    y = np.array(y_rows, dtype=np.int32)
    print(f"  real data: {X.shape[0]} training rows, {y.sum()} positive labels")
    return X, y


def train_from_synthetic():
    """Run a few self-play matches and build a small training set."""
    import numpy as np

    sys.path.insert(0, AGENT_DIR)
    from kaggle_environments import make

    print("  synthetic mode: running 4 self-play matches to build training data ...")
    X_rows = []
    y_rows = []

    for trial in range(4):
        env = make("kaggriculture", configuration={"episodeSteps": 720})
        env.run([os.path.join(AGENT_DIR, "main.py"), "starter"])
        steps = env.steps
        for step_idx, step in enumerate(steps):
            for player_idx in (0, 1):
                s = step[player_idx]
                obs = s.observation
                if not isinstance(obs, dict):
                    continue
                market = obs.get("market", {}) or {}
                prices = market.get("prices", {}) or {}
                private = obs.get("private", {}) or {}
                shed = private.get("shed", {}) or {}
                action = s.action if isinstance(s.action, dict) else {}
                m_orders = action.get("market", []) if isinstance(action, list) is False else []
                # Check if this player actually placed a sell order for WHEAT.
                wheat_sell_qty = 0
                for order in (m_orders or []):
                    if isinstance(order, list) and len(order) >= 2 and order[0] == "SELL" and order[1] == "WHEAT":
                        wheat_sell_qty = order[2] if len(order) >= 3 else 1
                day = obs.get("day", 0)
                hour = obs.get("hour", 0)
                wheat_price = prices.get("WHEAT", 25)
                wheat_qty = shed.get("WHEAT", 0)
                # Label heuristic: selling at >= the median price seen in
                # the next day is "good" (label 1), else 0.
                future_prices = []
                for k in range(step_idx + 1, min(step_idx + 24, len(steps))):
                    fp = (steps[k][player_idx].observation.get("market", {}) or {}).get("prices", {}).get("WHEAT", wheat_price)
                    future_prices.append(fp)
                if not future_prices or wheat_sell_qty == 0:
                    continue
                peak = max(future_prices)
                X_rows.append([day, hour, wheat_price, wheat_qty])
                y_rows.append(1 if wheat_price >= 0.8 * peak else 0)

    if len(X_rows) < 5:
        # Last-ditch: build a tiny brain with made-up data so the file exists.
        print("  ! not enough real training data; using a placeholder brain")
        X = np.array([
            [0, 0, 25, 0],
            [5, 0, 30, 10],
            [10, 0, 40, 50],
            [20, 0, 45, 100],
            [25, 0, 20, 50],  # price crash = hold
        ], dtype=np.float32)
        y = np.array([0, 0, 1, 1, 0], dtype=np.int32)
    else:
        X = np.array(X_rows, dtype=np.float32)
        y = np.array(y_rows, dtype=np.int32)

    print(f"  synthetic data: {X.shape[0]} training rows, {int(y.sum())} positive")
    return X, y


def train_and_save(X, y):
    from sklearn.tree import DecisionTreeClassifier
    clf = DecisionTreeClassifier(max_depth=5, random_state=42)
    clf.fit(X, y)
    with open(BRAIN_PATH, "wb") as f:
        pickle.dump(clf, f)
    size = os.path.getsize(BRAIN_PATH)
    print(f"  saved brain to {BRAIN_PATH} ({size} bytes)")
    return clf


def main():
    print("=" * 60)
    print("  TRAIN BRAIN v2.3")
    print("=" * 60)
    real = train_from_real_data()
    if real is None:
        X, y = train_from_synthetic()
    else:
        X, y = real
    train_and_save(X, y)
    print("Done. main.py will pick this up on next match.")


if __name__ == "__main__":
    main()
