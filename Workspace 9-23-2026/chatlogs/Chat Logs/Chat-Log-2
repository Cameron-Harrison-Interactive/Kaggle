def update_memory(step, prices):
    # Module globals normally persist during one episode. If a new episode starts,
    # reset the tiny trend tracker.
    if step < _MEMORY.get("last_step", -1):
        _MEMORY["last_prices"] = {}
        _MEMORY["price_dir"] = {}
    last = _MEMORY.get("last_prices", {}) or {}
    dirs = {}
    for item, price in (prices or {}).items():
        old = last.get(item, price)
        dirs[item] = price - old
    _MEMORY["last_prices"] = dict(prices or {})
    _MEMORY["price_dir"] = dirs
    _MEMORY["last_step"] = step


def scan_farm(farm, day):
    tiles = farm.get("tiles", []) or []
    board_size = len(tiles)
    info = {
        "empty": [], "weeds": [], "plants": [], "animals": [], "structures": [],
        "active": {c: 0 for c in CROPS},
        "mature": {c: 0 for c in CROPS},
        "unwatered": [], "harvestable": [],
    }
    for y, row in enumerate(tiles):
        for x, t in enumerate(row):
            if t is None:
                info["empty"].append((x, y))
            elif t == "LOCKED":
                continue
            elif isinstance(t, dict):
                kind = t.get("kind")
                if kind == "WEED":
                    info["weeds"].append((x, y))
                elif kind == "PLANT":
                    crop = t.get("crop")
                    if crop in CROPS:
                        age = day - t.get("planted_day", day)
                        info["active"][crop] += 1
                        info["plants"].append((x, y, crop, age, t))
                        if age >= CROPS[crop]["first"] and t.get("yield_units", 0) > 0:
                            info["harvestable"].append((x, y, crop, age, t))
                        if age >= CROPS[crop]["maxday"]:
                            info["mature"][crop] += 1
                        if not t.get("watered_today", False):
                            info["unwatered"].append((x, y, crop, age, t))
                elif kind in ("COOP", "PASTURE"):
                    info["structures"].append((x, y, kind, t))
                    if "animal" in t:
                        info["animals"].append((x, y, t.get("animal"), t))
    return info, board_size


