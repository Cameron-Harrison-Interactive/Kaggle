def choose_crop(active, targets, seeds, prices, cash=0):
    best = None
    best_score = -10**9
    for crop, cd in CROPS.items():
        if seeds.get(crop, 0) <= 0:
            continue
        want = targets.get(crop, 0) - active.get(crop, 0)
        if want <= 0:
            continue
        price = prices.get(crop, cd["seed"] * 2)
        gross = cd["max_yield"] * price - cd["seed"]
        score = want * 1000 + gross
        # keep wheat as utility/feed, but don't let it dominate every empty tile
        if crop == "WHEAT":
            score -= 150
        if crop == "MELON" and price < DNA.get("melon_crash_price", 185):
            score -= 2000
        if score > best_score:
            best_score = score
            best = crop
    return best


