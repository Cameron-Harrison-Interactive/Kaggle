# Per-crop tables (ground truth from kagriculture.py source).
# =============================================================================
CROPS = {
    "WHEAT":  {"seed": 10, "first_yield_day": 2, "max_yield_day": 4, "ongoing": False},
    "CARROT": {"seed": 20, "first_yield_day": 2, "max_yield_day": 3, "ongoing": False},
}


def manhattan(a, b):
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


def step_toward(pos, target):
    """One cardinal step toward target. Returns a list-form action (the engine
    wants lists, not bare strings)."""
    px, py = pos
    tx, ty = target
    if px < tx: return ["EAST"]
    if px > tx: return ["WEST"]
    if py < ty: return ["SOUTH"]
    if py > ty: return ["NORTH"]
