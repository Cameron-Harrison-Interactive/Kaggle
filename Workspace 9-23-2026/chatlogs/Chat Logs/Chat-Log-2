def agent(obs):
    try:
        player = obs.get("player", 0)
        step = safe_int(obs.get("step", 0))
        day = safe_int(obs.get("day", step // 24))
        hour = safe_int(obs.get("hour", step % 24))
        farms = obs.get("farms", []) or []
        if not farms or player >= len(farms):
            return {"farmer": ["PASS"], "hands": [], "market": []}

        my_farm = farms[player]
        opp_farm = farms[1 - player] if len(farms) > 1 else None
        private = obs.get("private", {}) or {}
        shed = private.get("shed", {}) or {}
        seeds = private.get("seeds", {}) or {}
        inventories = private.get("inventories", [{}]) or [{}]
        prices = (obs.get("market", {}) or {}).get("prices", {}) or {}
        cash = float(my_farm.get("money", 0) or 0)
        tiles = my_farm.get("tiles", []) or []
        hands = my_farm.get("hands", []) or []
        farmer_pos = my_farm.get("farmer", [4, 4]) or [4, 4]

        update_memory(step, prices)
        my_info, board_size = scan_farm(my_farm, day)
        opp_info, _ = scan_farm(opp_farm, day) if opp_farm else ({"active": {}, "mature": {}}, board_size)
        targets = dynamic_targets(my_info, opp_info, prices, day, step)
        is_dump = step >= int(DNA.get("dump_turn", 690))

        # Unit actions: farmer + current hands. Hires appear after market phase.
        reserved_plants = {}
        farmer_inv = inventories[0] if len(inventories) > 0 and isinstance(inventories[0], dict) else {}
        farmer_action = plan_unit(0, tuple(farmer_pos), farmer_inv, tiles, my_info, targets, seeds, shed, prices, day, step, reserved_plants)
        hand_actions = []
        for i, hp in enumerate(hands):
            inv = inventories[i + 1] if i + 1 < len(inventories) and isinstance(inventories[i + 1], dict) else {}
            hand_actions.append(plan_unit(i + 1, tuple(hp), inv, tiles, my_info, targets, seeds, shed, prices, day, step, reserved_plants))

        market = []
        # Hire early/mid day. They are extremely cheap and massively improve watering/harvesting.
        if not is_dump and hour <= 18:
            target_hires = int(DNA.get("target_hires", 4))
            while len(hands) + sum(1 for o in market if o == ["HIRE"]) < target_hires and len(market) < 4 and cash > 150:
                market.append(["HIRE"])
                cash -= 3  # rough reserve; real fib cost handled by engine

        # Land expansion after we have enough reserve. BUY_LAND has no args.
        if not is_dump and int(DNA.get("buy_land", 3)) > 0:
            unlocked = my_farm.get("unlocked_quadrants", ["NW"]) or ["NW"]
            extra = max(0, len(unlocked) - 1)
            if extra < min(3, int(DNA.get("buy_land", 3))):
                price = LAND_PRICES[extra]
                field_pressure = len(my_info["empty"]) < 5 or sum(my_info["active"].values()) >= 18 + extra * 8
                if cash >= price + int(DNA.get("land_reserve", 250)) and (field_pressure or day >= 5 + extra * 4):
                    market.append(["BUY_LAND"])
                    cash -= price

        # Animals: buy only if enough wheat/feed economy and before late game.
        if not is_dump and DNA.get("use_animals", 1) and day <= 16:
            have_goose = any(a == "GOOSE" for _, _, a, _ in my_info["animals"]) or shed.get("GOOSE", 0) > 0
            have_cow = any(a == "COW" for _, _, a, _ in my_info["animals"]) or shed.get("COW", 0) > 0
            if not have_goose and cash >= 460:
                market.append(["BUY_ANIMAL", "GOOSE", 1]); cash -= 300
            if day >= 5 and not have_cow and cash >= 950:
                market.append(["BUY_ANIMAL", "COW", 1]); cash -= 400
            # Emergency feed wheat; buy product goes to shed.
            if need_feed(my_info) and shed.get("WHEAT", 0) <= 0 and cash >= prices.get("WHEAT", 25) + 100:
                market.append(["BUY_PRODUCT", "WHEAT", 1]); cash -= prices.get("WHEAT", 25)

        # Buy seeds to match adaptive targets. Use batched orders to save order slots.
        if not is_dump:
            active = my_info["active"]
            # Safety wheat for feeding and cash cycle.
            desired_seed = {}
            for crop in CROPS:
                desired = max(0, targets.get(crop, 0) - active.get(crop, 0) - seeds.get(crop, 0))
                if crop == "WHEAT" and DNA.get("use_animals", 1):
                    desired = max(desired, 2 - seeds.get("WHEAT", 0))
                desired_seed[crop] = desired
            # Buy higher-value/urgent first, but skip melon under obvious crash.
            order = sorted(CROPS.keys(), key=lambda c: (c == "WHEAT", -prices.get(c, 0)))
            for crop in order:
                if len(market) >= 9:
                    break
                n = min(4, desired_seed.get(crop, 0))
                if n <= 0:
                    continue
                cost = CROPS[crop]["seed"] * n
                if crop == "MELON" and targets.get("MELON", 0) <= active.get("MELON", 0):
                    continue
                if cash >= cost + 80:
                    market.append(["BUY_SEED", crop, n])
                    cash -= cost

        # Sell products. Adaptive gates avoid selling melons into a crash unless end-game.
        opp_melon_loaded = (opp_info.get("active", {}) or {}).get("MELON", 0) >= int(DNA.get("melon_danger_opp", 6))
        for item in PRODUCTS:
            qty = safe_int(shed.get(item, 0))
            if qty <= 0 or len(market) >= 10:
                continue
            price = prices.get(item, 0)
            gate = int(DNA.get(item.lower() + "_sell", 9999))
            if item == "MELON":
                if opp_melon_loaded and price >= 220:
                    gate = min(gate, 220)  # preempt their dump
                elif price < int(DNA.get("melon_crash_price", 185)) and not is_dump:
                    continue              # hold after crash; sell other products instead
            brain_vote = _brain_says_sell(day, hour, price, qty)
            should_sell = is_dump or price >= gate or (brain_vote is True and price >= max(1, int(gate * 0.85)))
            if should_sell:
                market.append(["SELL", item, qty])

        return {"farmer": farmer_action, "hands": hand_actions, "market": market[:10]}
    except Exception:
        return {"farmer": ["PASS"], "hands": [], "market": []}
