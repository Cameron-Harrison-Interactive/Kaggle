def plan_unit(idx, pos, inv, tiles, info, targets, seeds, shed, prices, day, step, reserved_plants):
    board_size = len(tiles)
    x, y = pos
    tile = tiles[y][x] if 0 <= y < board_size and 0 <= x < len(tiles[y]) else "LOCKED"
    is_dump = step >= int(DNA.get("dump_turn", 690))

    carrying_goods = [k for k, v in (inv or {}).items() if v > 0 and k in PRODUCTS and not (k == "WHEAT" and need_feed(info))]
    if carrying_goods and is_shed_adjacent((x, y), board_size):
        return ["DROP"]

    # Animal direct actions if standing on one.
    if isinstance(tile, dict) and "animal" in tile:
        if tile.get("yield_units", 0) > 0:
            return ["HARVEST"]
        if not tile.get("fed_today", False) and inv.get("WHEAT", 0) > 0:
            return ["FEED"]
        if tile.get("fertilizer_available", False):
            return ["COLLECT_FERTILIZER"]
        if tile.get("fed_today", False) and not tile.get("cared_today", False):
            return ["CARE"]

    # Pick up feed/animals at shed if needed.
    if is_shed_adjacent((x, y), board_size):
        if need_feed(info) and inv.get("WHEAT", 0) <= 0 and shed.get("WHEAT", 0) > 0:
            return ["PICKUP", "WHEAT", 1]
        # Only one worker should deal with placing animals, prefer farmer/first hand.
        if idx <= 1:
            if shed.get("GOOSE", 0) > 0 and inv.get("GOOSE", 0) <= 0:
                return ["PICKUP", "GOOSE", 1]
            if shed.get("COW", 0) > 0 and inv.get("COW", 0) <= 0:
                return ["PICKUP", "COW", 1]

    # Structure actions / animal placement.
    if idx <= 1 and not is_dump:
        if tile is None and (x, y) == (4, 4) and not any(s[2] == "COOP" for s in info["structures"]):
            return ["BUILD_COOP"]
        if tile is None and (x, y) == (3, 4) and not any(s[2] == "PASTURE" for s in info["structures"]):
            return ["BUILD_PASTURE"]
        if isinstance(tile, dict) and tile.get("kind") == "COOP" and "animal" not in tile and inv.get("GOOSE", 0) > 0:
            return ["PLACE", "GOOSE"]
        if isinstance(tile, dict) and tile.get("kind") == "PASTURE" and "animal" not in tile and inv.get("COW", 0) > 0:
            return ["PLACE", "COW"]

    # Plant / crop tile actions.
    if isinstance(tile, dict) and tile.get("kind") == "PLANT":
        crop = tile.get("crop")
        age = day - tile.get("planted_day", day)
        cd = CROPS.get(crop, {})
        if tile.get("yield_units", 0) > 0:
            if is_dump or (not cd.get("ongoing", False) and age >= cd.get("maxday", 99)) or (cd.get("ongoing", False) and tile.get("yield_units", 0) >= 2):
                return ["HARVEST"]
        if not tile.get("watered_today", False):
            return ["WATER"]
        if tile.get("yield_units", 0) > 0 and age >= cd.get("first", 99):
            return ["HARVEST"]

    if tile is None and not is_dump:
        crop = choose_crop(info["active"], targets, seeds, prices)
        if crop and reserved_plants.get(crop, 0) < seeds.get(crop, 0):
            reserved_plants[crop] = reserved_plants.get(crop, 0) + 1
            info["active"][crop] = info["active"].get(crop, 0) + 1
            return ["PLANT", crop]

    if isinstance(tile, dict) and tile.get("kind") == "WEED":
        return ["DIG"]

    # Movement target list, in priority order.
    candidates = []
    # Deliver carried products before wasting time in far corners.
    if carrying_goods:
        candidates += shed_tiles(board_size)
    # Animals before plants because losing feed can make them escape.
    for ax, ay, animal, atile in info["animals"]:
        if atile.get("yield_units", 0) > 0 or not atile.get("fed_today", False) or atile.get("fertilizer_available", False):
            candidates.append((ax, ay))
    # Setup tiles near shed.
    if idx <= 1 and not is_dump:
        if not any(s[2] == "COOP" for s in info["structures"]):
            candidates.append((4, 4))
        elif shed.get("GOOSE", 0) > 0 or inv.get("GOOSE", 0) > 0:
