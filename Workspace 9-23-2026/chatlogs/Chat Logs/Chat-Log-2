        player = obs.get("player", 0)
        step = obs.get("step", 0)
        day = obs.get("day", 0)
        hour = obs.get("hour", 0)
        farms = obs.get("farms", [])
        if not farms or player >= len(farms):
            return {"farmer": ["PASS"], "hands": [], "market": []}
        my_farm = farms[player]
        private = obs.get("private", {}) or {}
        market_obs = obs.get("market", {}) or {}
        market_prices = market_obs.get("prices", {}) or {}
        cash = my_farm.get("money", 0)
        tiles = my_farm.get("tiles", [])
        fx, fy = my_farm.get("farmer", [4, 4])
        shed = private.get("shed", {}) or {}
        seeds = private.get("seeds", {}) or {}

        out = {"farmer": ["PASS"], "hands": [], "market": []}
        market = []
        is_dump = step >= DNA["dump_turn"]

        # Scan the field
        empty = []
        harvestable = []
        unwatered = []
        active_wheat = 0
        active_carrot = 0
        for y in range(len(tiles)):
            for x in range(len(tiles[y])):
                t = tiles[y][x]
                if t is None:
                    empty.append((x, y))
                elif isinstance(t, dict) and t.get("kind") == "PLANT":
                    crop = t.get("crop")
                    age = day - t.get("planted_day", day)
                    if crop == "WHEAT":  active_wheat += 1
                    elif crop == "CARROT": active_carrot += 1
                    if t.get("yield_units", 0) > 0 and age >= CROPS.get(crop, {}).get("max_yield_day", 99):
                        harvestable.append((x, y, crop))
                    elif not t.get("watered_today", False):
                        unwatered.append((x, y, crop))

        current_tile = tiles[fy][fx] if 0 <= fy < len(tiles) and 0 <= fx < len(tiles[0]) else None

        # Farmer action
        farmer_action = ["PASS"]
        if isinstance(current_tile, dict) and current_tile.get("kind") == "PLANT":
            if current_tile.get("yield_units", 0) > 0:
                age = day - current_tile.get("planted_day", day)
                crop = current_tile.get("crop")
                if age >= CROPS.get(crop, {}).get("max_yield_day", 99):
                    farmer_action = ["HARVEST"]
                elif not current_tile.get("watered_today", False):
                    farmer_action = ["WATER"]
            elif not current_tile.get("watered_today", False):
                farmer_action = ["WATER"]
        elif current_tile is None and not is_dump:
            if active_wheat < DNA["target_wheat"] and seeds.get("WHEAT", 0) > 0:
                farmer_action = ["PLANT", "WHEAT"]
            elif active_carrot < DNA["target_carrot"] and seeds.get("CARROT", 0) > 0:
                farmer_action = ["PLANT", "CARROT"]

        if farmer_action == ["PASS"]:
            target = None
            if harvestable:
                target = min(harvestable, key=lambda h: manhattan((fx, fy), (h[0], h[1])))[:2]
            elif unwatered:
                target = min(unwatered, key=lambda u: manhattan((fx, fy), (u[0], u[1])))[:2]
            elif empty and not is_dump:
                target = empty[0]
            if target is not None:
                if target == (fx, fy) and tiles[fy][fx] is None and not is_dump:
                    if active_wheat < DNA["target_wheat"] and seeds.get("WHEAT", 0) > 0:
                        farmer_action = ["PLANT", "WHEAT"]
                    elif active_carrot < DNA["target_carrot"] and seeds.get("CARROT", 0) > 0:
                        farmer_action = ["PLANT", "CARROT"]
                else:
                    farmer_action = step_toward((fx, fy), target)

        out["farmer"] = farmer_action

        # Market orders
        if not is_dump:
            if active_wheat < DNA["target_wheat"] and seeds.get("WHEAT", 0) < 3 and cash >= 10 + 50:
                market.append(["BUY_SEED", "WHEAT", 1])
            if active_carrot < DNA["target_carrot"] and seeds.get("CARROT", 0) < 2 and cash >= 20 + 50:
                market.append(["BUY_SEED", "CARROT", 1])

        if DNA.get("buy_land", 0) > 0 and not is_dump:
            unlocked = my_farm.get("unlocked_quadrants", ["NW"])
            n_unlocked_extra = len(unlocked) - 1
            LAND_PRICES = [1000, 2000, 4000]
            if n_unlocked_extra < DNA["buy_land"] and n_unlocked_extra < 3:
                if cash >= LAND_PRICES[n_unlocked_extra] + 200:
                    market.append(["BUY_LAND"])

        for item in ("WHEAT", "CARROT"):
            qty = shed.get(item, 0)
            if qty <= 0:
                continue
            price = market_prices.get(item, 0)
            ceiling = DNA.get(f"{item.lower()}_ceiling", 99999)
            if is_dump:
                market.append(["SELL", item, qty])
                continue
            brain_vote = _brain_says_sell(item, day, hour, price, qty)
            if brain_vote is True:
                market.append(["SELL", item, qty])
            elif brain_vote is False:
                if price >= ceiling:
                    market.append(["SELL", item, qty])
            else:
                if price >= ceiling:
                    market.append(["SELL", item, qty])

        out["market"] = market[:10]
        return out

    except Exception:
        return {"farmer": ["PASS"], "hands": [], "market": []}
