DNA_RANGES = {
    "target_wheat":   (4, 20, 1),
    "target_carrot":  (0, 12, 1),
    "max_total":      (10, 22, 1),
    "wheat_ceiling":  (28, 70, 2),
    "wheat_floor":    (10, 25, 1),
    "carrot_ceiling": (38, 60, 2),
    "carrot_floor":   (1, 18, 1),
    "dump_turn":      (650, 715, 3),
    "buy_land":       (0, 3, 1),
    "use_brain":      (0, 1, 1),
}


def load_dna(path):
    with open(path) as f:
        return json.load(f)


def save_dna(path, dna):
    with open(path, "w") as f:
        json.dump(dna, f, indent=2)


def mutate(parent):
    child = {}
    for k, (lo, hi, step) in DNA_RANGES.items():
        base = parent.get(k, (lo + hi) // 2)
        delta = random.choice([-step, 0, 0, step])
        new = max(lo, min(hi, base + delta))
        child[k] = new
    return child


def run_match(env, agent_path, opponent):
    env.run([agent_path, opponent])
    p0 = env.state[0].reward if env.state[0].reward is not None else 0
    p1 = env.state[1].reward if env.state[1].reward is not None else 0
    return p0, p1, env


def fitness(my_cash, opp_cash):
    if my_cash > opp_cash:
        return 0.7 * my_cash + 300
    elif my_cash == opp_cash:
        return 0.7 * my_cash
    else:
        return 0.7 * my_cash - 100


def main():
    print("=" * 60)
    print("  KAGRICULTURE AUTO-EVOLVER v2.3 (headless, rotating opps)")
    print("=" * 60)
    print(f"  Root: {ROOT}")
    print(f"  DNA:  {os.path.join(AGENT_DIR, 'dna.json')}")
    print(f"  Best: {os.path.join(DATA_DIR, 'Winning_DNA.json')}")
    print(f"  Replays: {REPLAY_DIR}")
